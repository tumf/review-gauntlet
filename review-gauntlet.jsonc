{
  // Minimal opencode command adapter configuration.
  // The generated OCR prompt is expanded into one argv element at {prompt}.
  "adapter": {
    "type": "command",
    "command": "opencode",
    "args": [
      "run",
      "--dangerously-skip-permissions",
      "{prompt}"
    ],
    "output": {
      "mode": "file-json",
      "path": "{output_file}"
    }
  }
}
