{
  // Minimal opencode command adapter configuration.
  // The generated OCR prompt is expanded into one argv element at {prompt}.
  // adapter.output is omitted intentionally: command adapters default to file-json
  // and the prompt instructs the command to write the verdict to {output_file}.
  "adapter": {
    "type": "command",
    "command": "opencode",
    "args": [
      "run",
      "{prompt}"
    ]
  }
}
