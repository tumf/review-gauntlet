#!/bin/sh

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

resolve_worktree_root() {
  if [ -n "${ROOT_WORKTREE_PATH:-}" ] && [ -d "${ROOT_WORKTREE_PATH}" ]; then
    printf '%s\n' "${ROOT_WORKTREE_PATH}"
    return 0
  fi

  if command -v git >/dev/null 2>&1; then
    if root=$(git rev-parse --show-toplevel 2>/dev/null); then
      if [ -n "${root}" ] && [ -d "${root}" ]; then
        printf '%s\n' "${root}"
        return 0
      fi
    fi
  fi

  printf '%s\n' "$(cd -- "${script_dir}/.." && pwd)"
}

worktree_root=$(resolve_worktree_root)

echo "wt: ${worktree_root}"

ensure_prek() {
  if command -v prek >/dev/null 2>&1; then
    return 0
  fi

  echo "error: prek is required but was not found on PATH" 1>&2
  echo "hint: install prek from a trusted package source, then rerun .wt/setup" 1>&2
  echo "hint: this bootstrap intentionally does not execute remote installers" 1>&2
  return 1
}

ensure_prek

echo "installing git hooks"
(cd -- "${worktree_root}" && prek install)

echo "done"
